│ ... 还有 {{ stories|length - 10 }} 个 Story
{% endif %}
└──────────────────────────────────────────────────────────────────────────────────────┘

{% endmacro -%}

{{ swimlane('待办', '📋', stories.TODO, stories.TODO|length) }}

{{ swimlane('进行中', '🚧', stories.IN_PROGRESS, stories.IN_PROGRESS|length) }}

{% if stories.IN_REVIEW %}
{{ swimlane('审查中', '👀', stories.IN_REVIEW, stories.IN_REVIEW|length) }}
{% endif %}

{% if stories.TESTING %}
{{ swimlane('测试中', '🧪', stories.TESTING, stories.TESTING|length) }}
{% endif %}

{{ swimlane('已完成', '✅', stories.COMPLETED, stories.COMPLETED|length) }}

{% if stories.BLOCKED %}
{{ swimlane('阻塞', '🚫', stories.BLOCKED, stories.BLOCKED|length) }}
{% endif %}

{% if stories.CANCELLED %}
{{ swimlane('已取消', '❌', stories.CANCELLED, stories.CANCELLED|length) }}
{% endif %}
```

